# TheMealDB — recipe data. Optional.
# Defaults to the public developer test key "1", which serves every endpoint
# this app uses. A Patreon supporter key raises the rate limit and unlocks the
# supporter-only endpoints. https://www.themealdb.com/api.php
MEALDB_API_KEY=1

# Spoonacular — extra cuisines (see SPOONACULAR_ONLY_AREAS) and nutrition data.
# Optional: without it those cuisines are hidden and nutrition falls back to
# Open Food Facts, then to an ingredient-based estimate.
SPOONACULAR_API_KEY=

# YouTube Data API — richer "Watch & Cook" video metadata. Optional.
YOUTUBE_API_KEY=
